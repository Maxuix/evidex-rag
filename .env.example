# P0/P1A local development only. Copy to .env and replace every placeholder.
RAG_KB__APP__DEPLOYMENT_PROFILE=development
RAG_KB__APP__BIND_HOST=127.0.0.1
RAG_KB__APP__API_PORT=8000
RAG_KB__APP__API_PREFIX=/api/v1

# Fixed server-side development identity. Clients cannot override these values.
RAG_KB__IDENTITY__PROVIDER=development_fixed
RAG_KB__IDENTITY__PRINCIPAL_ID=development-principal
RAG_KB__IDENTITY__CLIENT_ID=development-web
RAG_KB__IDENTITY__WORKSPACE_ID=01900000-0000-7000-8000-000000000001

# JSON list of explicit user/diagnostic loopback origins; wildcard and credentials are disabled.
RAG_KB__SECURITY__ALLOWED_CORS_ORIGINS=["http://127.0.0.1:3000","http://127.0.0.1:3001"]
RAG_KB__SECURITY__CORS_ALLOW_CREDENTIALS=false

# The usernames must match the separately configured runtime and migration roles.
RAG_KB__DATABASE__RUNTIME_DSN=postgresql+asyncpg://rag_kb_runtime:replace-locally@postgres:5432/rag_kb
RAG_KB__DATABASE__MIGRATION_DSN=postgresql+asyncpg://rag_kb_migration:replace-locally@postgres:5432/rag_kb
RAG_KB__DATABASE__RUNTIME_ROLE=rag_kb_runtime
RAG_KB__DATABASE__MIGRATION_ROLE=rag_kb_migration
RAG_KB__DATABASE__SERVER_CONNECTION_LIMIT=50
RAG_KB__DATABASE__RESERVED_CONNECTIONS=10
RAG_KB__DATABASE__API_POOL_SIZE=5
RAG_KB__DATABASE__API_MAX_OVERFLOW=5
RAG_KB__DATABASE__WORKER_POOL_SIZE=8
RAG_KB__DATABASE__WORKER_MAX_OVERFLOW=4

RAG_KB__JOB_POLLER__BACKEND=postgresql
RAG_KB__JOB_POLLER__POLL_INTERVAL_SECONDS=1
RAG_KB__JOB_POLLER__CHAT_CONCURRENCY=1
RAG_KB__JOB_POLLER__INDEXING_CONCURRENCY=1
RAG_KB__JOB_POLLER__CHAT_WEIGHT=3
RAG_KB__JOB_POLLER__INDEXING_WEIGHT=1
RAG_KB__JOB_POLLER__AGING_SECONDS=30
RAG_KB__JOB_POLLER__CHAT_START_TARGET_SECONDS=2
RAG_KB__JOB_POLLER__HEARTBEAT_INTERVAL_SECONDS=10
RAG_KB__JOB_POLLER__STALE_AFTER_SECONDS=120
RAG_KB__JOB_POLLER__MAX_ATTEMPTS=3
RAG_KB__JOB_POLLER__RETRY_BASE_DELAY_SECONDS=5
RAG_KB__JOB_POLLER__RETRY_MAX_DELAY_SECONDS=60
RAG_KB__JOB_POLLER__CHAT_DEADLINE_SECONDS=120
RAG_KB__JOB_POLLER__INDEXING_DEADLINE_SECONDS=900
RAG_KB__JOB_POLLER__RECONCILIATION_BATCH_SIZE=100

# Terminal SSE uses short database reads and never holds a connection while waiting.
RAG_KB__CHAT_DELIVERY__POLL_INTERVAL_SECONDS=1
RAG_KB__CHAT_DELIVERY__JITTER_RATIO=0.2
RAG_KB__CHAT_DELIVERY__MAX_CONNECTION_DURATION_SECONDS=600
RAG_KB__CHAT_DELIVERY__MAX_CONNECTIONS_PER_PRINCIPAL_RUN=2

RAG_KB__SESSION_CONTEXT__STRATEGY=recent_completed_turns_v1
RAG_KB__SESSION_CONTEXT__MAX_TURNS=6
RAG_KB__SESSION_CONTEXT__MAX_CONTEXT_TOKENS=4000
RAG_KB__SESSION_CONTEXT__TOKENIZER=cl100k_base
RAG_KB__SESSION_CONTEXT__QUERY_SCHEMA=contextual_query_v2
RAG_KB__SESSION_CONTEXT__CONFIGURATION_FINGERPRINT=sha256:7de39f7456bdf97eb6c41deab2b916d4f77c072d175faf546f297137763a1d20

# Compose must mount this same path in API and Worker. All three directories
# must already exist on one filesystem; startup never creates or repairs them.
RAG_KB__FILE_STORE__BACKEND=local
RAG_KB__FILE_STORE__ROOT_PATH=/var/lib/rag-kb/sources
RAG_KB__FILE_STORE__STAGING_PATH=/var/lib/rag-kb/sources/staging
RAG_KB__FILE_STORE__FINAL_PATH=/var/lib/rag-kb/sources/final
RAG_KB__FILE_STORE__ASSET_STAGING_PATH=/var/lib/rag-kb/sources/asset-staging
RAG_KB__FILE_STORE__ASSET_FINAL_PATH=/var/lib/rag-kb/sources/assets
RAG_KB__FILE_STORE__PARSER_TEMP_PATH=/var/lib/rag-kb/sources/parser-temp
RAG_KB__FILE_STORE__RECONCILIATION_INTERVAL_SECONDS=30
RAG_KB__FILE_STORE__ORPHAN_GRACE_SECONDS=300
RAG_KB__FILE_STORE__RECONCILIATION_BATCH_SIZE=100
RAG_KB__FILE_STORE__CLEANUP_MAX_ATTEMPTS=5
RAG_KB__FILE_STORE__CLEANUP_BASE_DELAY_SECONDS=5

# One-shot development maintenance keeps active/candidate data unreachable from
# deletion and expires only retired derived data and old terminal task facts.
RAG_KB__MAINTENANCE__BATCH_SIZE=100
RAG_KB__MAINTENANCE__RETIRED_DATA_GRACE_SECONDS=300
RAG_KB__MAINTENANCE__TASK_RETENTION_SECONDS=604800

# Frozen document-admission and parser budgets. The Docling shadow parser uses
# only the content-addressed offline bundle baked into the application image.
RAG_KB__FILE_ADMISSION__MAX_BYTES=10485760
RAG_KB__FILE_ADMISSION__MAX_MARKDOWN_BUNDLE_BYTES=20971520
RAG_KB__FILE_ADMISSION__MAX_LINES=200000
RAG_KB__FILE_ADMISSION__MAX_ARCHIVE_ENTRIES=10000
RAG_KB__FILE_ADMISSION__MAX_EXPANDED_BYTES=104857600
RAG_KB__PARSER__PROFILE=docling_text_local_v1
RAG_KB__PARSER__DOCLING_ARTIFACTS_PATH=/opt/rag-kb/docling-artifacts
RAG_KB__PARSER__DOCLING_ARTIFACT_MANIFEST_PATH=/app/config/docling-artifacts-v1.json
RAG_KB__PARSER__MAX_FILE_SIZE=10485760
RAG_KB__PARSER__MAX_MARKDOWN_BUNDLE_SIZE=20971520
RAG_KB__PARSER__MAX_NUM_PAGES=500
RAG_KB__PARSER__DOCUMENT_TIMEOUT_SECONDS=600
RAG_KB__PARSER__MAX_DOCLING_ITEMS=20000
RAG_KB__PARSER__MAX_CHUNKS=20000
RAG_KB__PARSER__MAX_EXTRACTED_CHARACTERS=5000000
RAG_KB__PARSER__MAX_METADATA_BYTES=65536
RAG_KB__PARSER__MAX_ASSETS=1000
RAG_KB__PARSER__MAX_TOTAL_ASSET_BYTES=104857600
RAG_KB__PARSER__MAX_IMAGE_PIXELS=40000000
RAG_KB__PARSER__MAX_IMAGE_WIDTH=16384
RAG_KB__PARSER__MAX_IMAGE_HEIGHT=16384
RAG_KB__PARSER__MAX_OCR_CHARACTERS=2000000
RAG_KB__PARSER__MAX_OCR_TOKENS=500000
RAG_KB__PARSER__MAX_CAPTION_TOKENS=512
RAG_KB__PARSER__MAX_TABLE_HTML_BYTES=1048576
RAG_KB__PARSER__MAX_UNITS=20000
RAG_KB__PARSER__MAX_REPRESENTATIONS=60000

RAG_KB__VECTOR_STORE__BACKEND=pgvector
RAG_KB__VECTOR_STORE__EXACT_SEARCH=true
RAG_KB__VECTOR_STORE__HNSW_ENABLED=false

# Raw endpoints and keys remain local configuration. The example domains are
# deliberately non-routable and must be replaced before startup.
RAG_KB__MODEL_PROVIDER__CHAT__BASE_URL=https://replace-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
RAG_KB__MODEL_PROVIDER__CHAT__API_KEY=replace-locally
RAG_KB__MODEL_PROVIDER__CHAT__LOGICAL_ENDPOINT_IDENTITY=alibaba-model-studio-beijing-chat
RAG_KB__MODEL_PROVIDER__CHAT__PROVIDER_IDENTITY=alibaba-cloud-model-studio-qwen
RAG_KB__MODEL_PROVIDER__CHAT__MODEL=qwen3.7-plus
RAG_KB__MODEL_PROVIDER__CHAT__RESOLVED_MODEL=qwen3.7-plus
RAG_KB__MODEL_PROVIDER__CHAT__MODEL_VERSION=qwen3.7-plus
RAG_KB__MODEL_PROVIDER__CHAT__TIMEOUT_SECONDS=30
RAG_KB__MODEL_PROVIDER__CHAT__MAX_RETRIES=2
RAG_KB__MODEL_PROVIDER__CHAT__MAX_CONCURRENCY=2
RAG_KB__MODEL_PROVIDER__CHAT__TEMPERATURE=0.1
RAG_KB__MODEL_PROVIDER__CHAT__MAX_TOKENS=2048
RAG_KB__MODEL_PROVIDER__CHAT__STRUCTURED_OUTPUT_MODE=json_object
RAG_KB__MODEL_PROVIDER__CHAT__THINKING_ENABLED=false
RAG_KB__MODEL_PROVIDER__CHAT__VISION_ENABLED=true
RAG_KB__MODEL_PROVIDER__CHAT__MAX_VISUAL_IMAGES=2
RAG_KB__MODEL_PROVIDER__CHAT__MAX_VISUAL_IMAGE_BYTES=5242880
RAG_KB__MODEL_PROVIDER__CHAT__MAX_VISUAL_TOTAL_BYTES=12582912
RAG_KB__MODEL_PROVIDER__CHAT__MAX_VISUAL_PIXELS=16000000
RAG_KB__MODEL_PROVIDER__CHAT__VISUAL_MEDIA_PROFILE=jpeg_png_webp_v1
RAG_KB__MODEL_PROVIDER__CHAT__CONFIGURATION_FINGERPRINT=sha256:85b03b3eececbb2fda11cadf77040999028b09e335b8ef5684c34a34601a71d2
RAG_KB__MODEL_PROVIDER__CHAT__CAPABILITY_FINGERPRINT=sha256:c24fb9b08baf600afc8f4610f88412ca5c7a2979890647e1512e7cedb8066279

RAG_KB__MODEL_PROVIDER__EMBEDDING__BASE_URL=https://embedding-provider.example.invalid/v1
RAG_KB__MODEL_PROVIDER__EMBEDDING__API_KEY=replace-locally
RAG_KB__MODEL_PROVIDER__EMBEDDING__LOGICAL_ENDPOINT_IDENTITY=alibaba-model-studio-beijing-embedding
RAG_KB__MODEL_PROVIDER__EMBEDDING__PROVIDER_IDENTITY=alibaba-cloud-model-studio-qwen
RAG_KB__MODEL_PROVIDER__EMBEDDING__MODEL=qwen3.7-text-embedding
RAG_KB__MODEL_PROVIDER__EMBEDDING__RESOLVED_MODEL=qwen3.7-text-embedding
RAG_KB__MODEL_PROVIDER__EMBEDDING__MODEL_VERSION=qwen3.7-text-embedding
RAG_KB__MODEL_PROVIDER__EMBEDDING__DIMENSION=1024
RAG_KB__MODEL_PROVIDER__EMBEDDING__METRIC=cosine
RAG_KB__MODEL_PROVIDER__EMBEDDING__VECTOR_DATA_TYPE=float32
RAG_KB__MODEL_PROVIDER__EMBEDDING__NORMALIZATION=l2
RAG_KB__MODEL_PROVIDER__EMBEDDING__MAX_BATCH_SIZE=10
RAG_KB__MODEL_PROVIDER__EMBEDDING__CONFIGURATION_FINGERPRINT=sha256:5f774411565f9aaef04c7a9762bf6e245589cff064c396a8c5b38eb9098ac18f
RAG_KB__MODEL_PROVIDER__EMBEDDING__COMPATIBILITY_FINGERPRINT=sha256:398af80b01c3e440c0edf5871de60f80fdab255f453bfa6c685c65e2f9be61c7
RAG_KB__MODEL_PROVIDER__EMBEDDING__TIMEOUT_SECONDS=30
RAG_KB__MODEL_PROVIDER__EMBEDDING__MAX_RETRIES=2
RAG_KB__MODEL_PROVIDER__EMBEDDING__MAX_CONCURRENCY=2

# Independent text/image embeddings in one 768-dimensional shared space.
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__API_KEY=replace-locally
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__LOGICAL_ENDPOINT_IDENTITY=alibaba-model-studio-beijing-multimodal-embedding
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__PROVIDER_IDENTITY=alibaba-cloud-model-studio-qwen
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__MODEL=tongyi-embedding-vision-flash-2026-03-06
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__RESOLVED_MODEL=tongyi-embedding-vision-flash-2026-03-06
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__MODEL_VERSION=tongyi-embedding-vision-flash-2026-03-06
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__DIMENSION=768
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__METRIC=cosine
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__VECTOR_DATA_TYPE=float32
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__NORMALIZATION=l2
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__MAX_BATCH_SIZE=20
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__TEXT_QUERY_TEMPLATE=query: {text}
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__IMAGE_RESIZE_POLICY=provider_res_level_1_no_crop_v1
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__COLOR_SPACE=RGB
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__CONFIGURATION_FINGERPRINT=sha256:a3c9bcf7f049967db37f8bb59bb16504a0f371a14d0adfc793338d0eeecd856b
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__COMPATIBILITY_FINGERPRINT=sha256:953af16a5423f52cfdb65efb499a7181212be4760636f9a4ef428a959d9d9da2
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__TIMEOUT_SECONDS=30
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__MAX_RETRIES=2
RAG_KB__MODEL_PROVIDER__MULTIMODAL_EMBEDDING__MAX_CONCURRENCY=2
RAG_KB__MODEL_PROVIDER__RERANK_ENABLED=false

RAG_KB__RETRIEVAL__STRATEGY=exact_vector
RAG_KB__RETRIEVAL__TOP_K=10
RAG_KB__RETRIEVAL__MIN_COSINE_SIMILARITY=0.35
RAG_KB__RETRIEVAL__MIN_RERANK_SCORE=0.45
RAG_KB__RETRIEVAL__CANDIDATE_MULTIPLIER=4
RAG_KB__RETRIEVAL__MAX_CANDIDATE_COUNT=40
RAG_KB__RETRIEVAL__VECTOR_WEIGHT=0.65
RAG_KB__RETRIEVAL__LEXICAL_WEIGHT=0.35
RAG_KB__RETRIEVAL__MMR_LAMBDA=0.75
RAG_KB__RETRIEVAL__HYBRID_ENABLED=false
RAG_KB__RETRIEVAL__RERANK_ENABLED=true
RAG_KB__RETRIEVAL__CROSS_MODAL_CANDIDATE_COUNT=20
RAG_KB__RETRIEVAL__CROSS_MODAL_MIN_COSINE_SIMILARITY=0.25
RAG_KB__RETRIEVAL__RRF_K=60
RAG_KB__RETRIEVAL__CROSS_MODAL_WEIGHT_MICROS=1000000

RAG_KB__DELIVERY_RELIABILITY__SECOND_QUEUE_ENABLED=false
RAG_KB__DELIVERY_RELIABILITY__RETAINED_EVENT_REPLAY_ENABLED=false
RAG_KB__DELIVERY_RELIABILITY__MULTI_RUNNER_RECOVERY_ENABLED=false
RAG_KB__DELIVERY_RELIABILITY__OUTBOX_DELIVERY_ENABLED=false

RAG_KB__OBSERVABILITY__LOG_LEVEL=INFO
RAG_KB__OBSERVABILITY__LOG_FORMAT=json
RAG_KB__OBSERVABILITY__INCLUDE_CONTENT=false
RAG_KB__OBSERVABILITY__TRACING_ENABLED=false
