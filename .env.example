# Local development only. Copy once to .env.local and replace every database
# placeholder consistently. It is the single ignored manifest used by Compose
# and the application; do not create a second .env.
COMPOSE_PROJECT_NAME=rag
RAG_KB_API_PORT=8000
RAG_KB_FRONTEND_PORT=3000
RAG_KB_POSTGRES_PORT=5432
RAG_KB_FALKORDB_PORT=6379
POSTGRES_ADMIN_PASSWORD=replace-locally
RAG_KB_MIGRATION_PASSWORD=replace-locally
RAG_KB_RUNTIME_PASSWORD=replace-locally

# Model providers are configured in Web Chat after startup. There is no
# environment fallback for current model profiles.
RAG_KB__APP__BIND_HOST=127.0.0.1
RAG_KB__APP__API_PORT=8000

# Fixed server-side development identity. Clients cannot override these values.
RAG_KB__IDENTITY__PRINCIPAL_ID=development-principal
RAG_KB__IDENTITY__CLIENT_ID=development-web
RAG_KB__IDENTITY__WORKSPACE_ID=01900000-0000-7000-8000-000000000001

# JSON list of explicit user frontend loopback origins.
RAG_KB__SECURITY__ALLOWED_CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000","http://127.0.0.1:5173","http://localhost:5173"]

# DSN usernames are fixed to rag_kb_runtime and rag_kb_migration.
RAG_KB__DATABASE__RUNTIME_DSN=postgresql+asyncpg://rag_kb_runtime:replace-locally@postgres:5432/rag_kb
RAG_KB__DATABASE__MIGRATION_DSN=postgresql+asyncpg://rag_kb_migration:replace-locally@postgres:5432/rag_kb
RAG_KB__DATABASE__SERVER_CONNECTION_LIMIT=50
RAG_KB__DATABASE__RESERVED_CONNECTIONS=10
RAG_KB__DATABASE__API_POOL_SIZE=5
RAG_KB__DATABASE__API_MAX_OVERFLOW=5
RAG_KB__DATABASE__WORKER_POOL_SIZE=8
RAG_KB__DATABASE__WORKER_MAX_OVERFLOW=4
RAG_KB__DATABASE__API_STATEMENT_TIMEOUT_MS=30000
RAG_KB__DATABASE__WORKER_STATEMENT_TIMEOUT_MS=60000
RAG_KB__DATABASE__MAINTENANCE_STATEMENT_TIMEOUT_MS=300000
RAG_KB__DATABASE__LOCK_TIMEOUT_MS=5000
RAG_KB__DATABASE__IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=30000

RAG_KB__JOB_POLLER__POLL_INTERVAL_SECONDS=1
RAG_KB__JOB_POLLER__HEARTBEAT_INTERVAL_SECONDS=10
RAG_KB__JOB_POLLER__STALE_AFTER_SECONDS=120
RAG_KB__JOB_POLLER__MAX_ATTEMPTS=3
RAG_KB__JOB_POLLER__RETRY_BASE_DELAY_SECONDS=5
RAG_KB__JOB_POLLER__RETRY_MAX_DELAY_SECONDS=60
RAG_KB__JOB_POLLER__CHAT_DEADLINE_SECONDS=420
RAG_KB__JOB_POLLER__RECONCILIATION_BATCH_SIZE=100

# Terminal SSE uses short database reads and never holds a connection while waiting.
# The historically named preview transport carries content-safe Agent progress.
# It is best-effort and non-replayable. The local development profile enables it
# explicitly; the Settings fallback remains disabled.
RAG_KB__CHAT_DELIVERY__POLL_INTERVAL_SECONDS=1
RAG_KB__CHAT_DELIVERY__JITTER_RATIO=0.2
RAG_KB__CHAT_DELIVERY__MAX_CONNECTION_DURATION_SECONDS=600
RAG_KB__CHAT_DELIVERY__MAX_CONNECTIONS_PER_PRINCIPAL_RUN=2
RAG_KB__CHAT_DELIVERY__PREVIEW_ENABLED=true
RAG_KB__CHAT_DELIVERY__PREVIEW_QUEUE_SIZE=64
# Compose must mount this same path in API and Worker. All three directories
# must already exist on one filesystem; startup never creates or repairs them.
RAG_KB__FILE_STORE__ROOT_PATH=/var/lib/rag-kb/sources
RAG_KB__FILE_STORE__STAGING_PATH=/var/lib/rag-kb/sources/staging
RAG_KB__FILE_STORE__FINAL_PATH=/var/lib/rag-kb/sources/final
RAG_KB__FILE_STORE__ASSET_STAGING_PATH=/var/lib/rag-kb/sources/asset-staging
RAG_KB__FILE_STORE__ASSET_FINAL_PATH=/var/lib/rag-kb/sources/assets
RAG_KB__FILE_STORE__PARSER_TEMP_PATH=/var/lib/rag-kb/sources/parser-temp
RAG_KB__FILE_STORE__RECONCILIATION_INTERVAL_SECONDS=30
RAG_KB__FILE_STORE__ORPHAN_GRACE_SECONDS=300
RAG_KB__FILE_STORE__RECONCILIATION_BATCH_SIZE=100
RAG_KB__FILE_STORE__CLEANUP_MAX_ATTEMPTS=5
RAG_KB__FILE_STORE__CLEANUP_BASE_DELAY_SECONDS=5

# One-shot development maintenance keeps active/candidate data unreachable from
# deletion and expires only retired derived data and old terminal task facts.
RAG_KB__MAINTENANCE__BATCH_SIZE=100
RAG_KB__MAINTENANCE__RETIRED_DATA_GRACE_SECONDS=300
RAG_KB__MAINTENANCE__TASK_RETENTION_SECONDS=604800

# The fixed parser limits live beside the parser domain defaults. Only paths
# that can differ between local runtimes remain environment settings.
RAG_KB__PARSER__DOCLING_ARTIFACTS_PATH=/opt/rag-kb/docling-artifacts
RAG_KB__PARSER__DOCLING_ARTIFACT_MANIFEST_PATH=/app/config/docling-artifacts-v1.json

RAG_KB__RETRIEVAL__DEADLINE_SECONDS=240
RAG_KB__RETRIEVAL__MIN_COSINE_SIMILARITY=0.35
RAG_KB__RETRIEVAL__MIN_RERANK_SCORE=0.45
RAG_KB__RETRIEVAL__CANDIDATE_MULTIPLIER=4
RAG_KB__RETRIEVAL__MAX_CANDIDATE_COUNT=40
RAG_KB__RETRIEVAL__VECTOR_WEIGHT=0.65
RAG_KB__RETRIEVAL__LEXICAL_WEIGHT=0.35
RAG_KB__RETRIEVAL__MMR_LAMBDA=0.75
RAG_KB__RETRIEVAL__HYBRID_ENABLED=false
RAG_KB__RETRIEVAL__LEXICAL_CANDIDATE_COUNT=40
RAG_KB__RETRIEVAL__DENSE_WEIGHT_MICROS=1000000
RAG_KB__RETRIEVAL__LEXICAL_WEIGHT_MICROS=1000000
RAG_KB__RETRIEVAL__RERANK_ENABLED=true
RAG_KB__RETRIEVAL__CROSS_MODAL_CANDIDATE_COUNT=20
RAG_KB__RETRIEVAL__CROSS_MODAL_MIN_COSINE_SIMILARITY=0.25
RAG_KB__RETRIEVAL__RRF_K=60
RAG_KB__RETRIEVAL__CROSS_MODAL_WEIGHT_MICROS=1000000

# FalkorDB used by Graphiti. Compose overrides host to the `falkordb` service.
# Outside compose, the published loopback port is 127.0.0.1:6379.
RAG_KB__GRAPHITI__HOST=127.0.0.1
RAG_KB__GRAPHITI__PORT=6379

RAG_KB__OBSERVABILITY__LOG_LEVEL=INFO
RAG_KB__OBSERVABILITY__LOG_DIRECTORY=/var/log/rag-kb
